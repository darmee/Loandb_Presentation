# Copy to .env and fill in. .env is gitignored - never commit real credentials.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Read-only connection to the loan application database.
#
# Do NOT use the `postgres` superuser here. Create a dedicated read-only role:
#
#   CREATE ROLE loan_reader LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE dash_loans TO loan_reader;
#   GRANT USAGE ON SCHEMA public TO loan_reader;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO loan_reader;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO loan_reader;
#
# The last line matters: it covers tables added later, so a new loan product
# does not silently become invisible to this portal.
LOANS_DB_NAME=dash_loans
LOANS_DB_USER=loan_reader
LOANS_DB_PASSWORD=
LOANS_DB_HOST=127.0.0.1
LOANS_DB_PORT=5432

# Production only (ignored while DJANGO_DEBUG=True)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_TLS_PROXY=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# Exports and document downloads carry BVN, NIN, date of birth and next-of-kin
# details. Masked unless deliberately enabled.
EXPORT_INCLUDE_PII=False

# Server binding. 8000-8002 and 8500 are taken by other apps on the VM.
DJANGO_BIND_HOST=0.0.0.0
DJANGO_PORT=8600
DJANGO_THREADS=8

# Reverse proxy that is allowed to set X-Forwarded-* headers.
DJANGO_TRUSTED_PROXY=127.0.0.1
