# Copy to .env and fill in. .env is gitignored - never commit real credentials.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Read-only connection to the loan application database.
#
# Do NOT use the `postgres` superuser here. Create a dedicated read-only role:
#
#   CREATE ROLE loan_reader LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE dash_loans TO loan_reader;
#   GRANT USAGE ON SCHEMA public TO loan_reader;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO loan_reader;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO loan_reader;
#
# The last line matters: it covers tables added later, so a new loan product
# does not silently become invisible to this portal.
LOANS_DB_NAME=dash_loans
LOANS_DB_USER=loan_reader
LOANS_DB_PASSWORD=
LOANS_DB_HOST=127.0.0.1
LOANS_DB_PORT=5432

# Production only (ignored while DJANGO_DEBUG=True)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_TLS_PROXY=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# Server binding. 8000-8002 and 8500 are taken by other apps on the VM.
DJANGO_BIND_HOST=0.0.0.0
DJANGO_PORT=8600
DJANGO_THREADS=8

# Reverse proxy that is allowed to set X-Forwarded-* headers.
DJANGO_TRUSTED_PROXY=127.0.0.1

# Forgot password. The address people open the dashboard at - the reset link
# in the email is built on it.
DJANGO_PUBLIC_URL=
# Only addresses on this domain can be sent a reset link.
PASSWORD_RESET_EMAIL_DOMAIN=dash-mfb.com
# The email provider - where the reset emails are sent from. Fill in ONE of
# the two blocks. Leave both empty and the email is printed to the console
# instead of sent (development).
#
# 1. Microsoft Graph (Microsoft 365) - MSGRAPH_ or MS_GRAPH_, either spelling.
#    An app registration in Entra ID with the
#    Microsoft Graph APPLICATION permission Mail.Send, admin consent granted,
#    and a client secret. MSGRAPH_SENDER is the mailbox it sends from.
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_SENDER=
#
# 2. SMTP, instead of Graph.
#   Microsoft 365: smtp.office365.com, port 587, TLS
#   Google Workspace: smtp.gmail.com, port 587, TLS (needs an app password)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
#
# The name and address the email shows as from (defaults to the sender).
DEFAULT_FROM_EMAIL=

# Sign in with OCI IAM (Oracle identity domain, OpenID Connect). Leave the
# first three empty to hide the button. In OCI: Domains > Integrated
# applications > Confidential application, grant type Authorization code.
# ISSUER_URL is the domain URL from the domain's Overview page.
OCI_SSO_ISSUER_URL=
OCI_SSO_CLIENT_ID=
OCI_SSO_CLIENT_SECRET=
# Must match a Redirect URL on the OCI application exactly. Optional: defaults
# to DJANGO_PUBLIC_URL + /login/sso/callback/
OCI_SSO_REDIRECT_URI=
