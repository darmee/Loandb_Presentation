# Virtualenv
.venv/

# Python
__pycache__/
*.py[cod]

# Secrets - never commit
.env

# Local databases (Django's own tables, and any local development copy)
*.sqlite3

# Audit log: contains usernames, IP addresses, export and document-access
# activity. Every line names a real person.
logs/

# Exported data. Every export carries applicant names, BVNs, NINs, dates of
# birth, addresses, next-of-kin details and account numbers - none of it
# belongs in version control.
# If you ever genuinely need to commit one: git add -f <file>
*.csv
*.xlsx

# Database dumps - the schema is fine, the data is not. Neither is committed
# by default; the schema dump is kept out because it can carry defaults and
# comments that leak internal detail.
*.sql
*.dump

# Generated by collectstatic
staticfiles/

# macOS
.DS_Store
